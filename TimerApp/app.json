{
  "expo": {
    "name": "Ayush14 Timer",
    "slug": "TimerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "timerapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EBF8FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.rambhaji.timerapp",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#273AF8",
          "defaultChannel": "worker-channel-1",
          "sounds": [
            "./assets/sounds/alarm1.wav",
            "./assets/sounds/alarm2.wav",
            "./assets/sounds/alarm3.wav",
            "./assets/sounds/alarm4.wav",
            "./assets/sounds/alarm5.wav",
            "./assets/sounds/alarm6.wav",
            "./assets/sounds/alarm7.wav",
            "./assets/sounds/alarm8.wav"
          ]
        }
      ],
      "expo-secure-store",
      "react-native-notify-kit",
      "./plugins/withLockScreenAlarm.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "983d87e9-d6c5-4e7e-b1cc-ca54a14cf388"
      }
    },
    "owner": "ishhexpo"
  }
}
